file(READ "${PILI_NATIVEAPI_PACKAGE}/prebuilt/SHA256SUMS" manifest)
string(SUBSTRING "${manifest}" 0 64 expected)
set(archive "${PILI_NATIVEAPI_PACKAGE}/prebuilt/windows-x64.zip")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${archive}" "${PILI_NATIVEAPI_PACKAGE}/prebuilt/SHA256SUMS")
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "cnativeapi archive SHA256 mismatch")
endif()
set(runtime "${CMAKE_BINARY_DIR}/nativeapi-prebuilt-${actual}")
if(NOT EXISTS "${runtime}/SHA256SUMS")
  file(MAKE_DIRECTORY "${runtime}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
    WORKING_DIRECTORY "${runtime}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "cnativeapi extraction failed")
  endif()
endif()
get_filename_component(workspace "${PILI_NATIVEAPI_PACKAGE}/../.." ABSOLUTE)
foreach(list_name BUILD_INPUTS SHA256SUMS)
  file(STRINGS "${runtime}/${list_name}" entries)
  foreach(entry IN LISTS entries)
    string(SUBSTRING "${entry}" 0 64 expected)
    string(SUBSTRING "${entry}" 66 -1 name)
    if(name MATCHES "\\.\\." OR IS_ABSOLUTE "${name}")
      message(FATAL_ERROR "Invalid cnativeapi manifest path")
    endif()
    if(list_name STREQUAL "BUILD_INPUTS")
      set(path "${workspace}/${name}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    else()
      set(path "${runtime}/${name}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "cnativeapi input changed: ${name}; run third_party/nativeapi/build.ps1")
    endif()
  endforeach()
endforeach()
# 固定 ZIP 时间戳下，增量安装仍需覆盖旧 DLL。
file(TOUCH_NOCREATE "${runtime}/cnativeapi.dll")
set(cnativeapi_bundled_libraries "${runtime}/cnativeapi.dll" PARENT_SCOPE)
install(DIRECTORY "${runtime}/licenses/"
  DESTINATION "${CMAKE_INSTALL_PREFIX}/nativeapi-licenses" COMPONENT Runtime)
message(STATUS "Using verified prebuilt cnativeapi")
